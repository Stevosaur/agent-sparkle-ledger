# --- Core ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pasarcatch
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000

# --- AI (optional; without it PasarCatch runs its deterministic heuristic agents in MOCK mode) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- WhatsApp Cloud API (optional; simulator used when absent) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# --- OneMap (optional; straight-line routing mock used when absent) ---
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

# --- data.gov.sg weather (optional; public real-time API, key optional) ---
DATAGOV_API_KEY=
WEATHER_ENABLED=false

# --- Storage ---
STORAGE_DIR=./storage

# --- Jobs endpoint shared secret (for cron) ---
JOBS_SECRET=change-me
