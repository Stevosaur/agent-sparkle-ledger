# ---------------------------------------------------------------------------
# Plotline environment. Every integration is optional: without a block, the
# matching feature degrades gracefully (see README "Integrations").
# ---------------------------------------------------------------------------

# Public URL (canonical links, sitemap, Stripe redirects). Vercel sets VERCEL_PROJECT_PRODUCTION_URL automatically.
NEXT_PUBLIC_SITE_URL=

# --- Accounts (Supabase) -----------------------------------------------------
# Without these, the site runs in "preview" mode: no sign-in, every feature unlocked.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only key for Stripe webhooks, lead storage and cron jobs (Supabase "secret" or legacy service_role key)
SUPABASE_SECRET_KEY=
# Force gating: open | enforce (default: enforce when Supabase is configured)
GATING_MODE=

# --- Payments (Stripe) ------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# Display prices (SGD) shown on /plus/ — keep in sync with the Stripe prices above
NEXT_PUBLIC_PLUS_MONTHLY_PRICE=49
NEXT_PUBLIC_PLUS_YEARLY_PRICE=499
NEXT_PUBLIC_PLUS_TRIAL_DAYS=7

# --- AI assistant (Anthropic) ---------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- Leads & contact ----------------------------------------------------------
NEXT_PUBLIC_CONTACT_EMAIL=
# International format without "+", e.g. 6591234567
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Optional: POST every new lead as JSON to this URL (Slack/Make/Zapier webhook)
LEADS_WEBHOOK_URL=

# --- Alerts -----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Shared secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# --- Data pipeline (GitHub Actions secrets; not needed by the web app) ------
# URA Data Service access key (private property transactions, rentals, launches)
URA_ACCESS_KEY=
# data.gov.sg API key (optional, raises rate limits)
DATAGOV_API_KEY=
